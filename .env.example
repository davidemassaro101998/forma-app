# GEMINI_API_KEY: Required for Gemini AI API calls (product recommendations, chat, TTS).
# Get a key from https://aistudio.google.com/apikey and set it as a secret/env var
# on your host (e.g. Railway → Variables). Without it, the app still works but
# falls back to the local, non-AI product suggestions.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where this app is hosted. Used for self-referential links.
# On Railway this is typically your generated *.up.railway.app domain or custom domain.
APP_URL="MY_APP_URL"

# PORT: Port the Express server listens on. Optional — Railway (and most hosts)
# inject this automatically at runtime, so you normally don't need to set it
# yourself. Defaults to 3000 for local development.
# PORT=3000

# VITE_AMAZON_TAG_*: Amazon Associate tracking tags per country/store, used to
# build affiliate links. These are build-time Vite env vars (must be prefixed
# with VITE_ to be exposed to the client). If unset, the app falls back to
# built-in placeholder tags — replace with your real Associate tags per store
# once available.
# VITE_AMAZON_TAG_US="your-us-tag-20"
# VITE_AMAZON_TAG_IT="your-it-tag-21"
# VITE_AMAZON_TAG_UK="your-uk-tag-21"
# VITE_AMAZON_TAG_DE="your-de-tag-21"
# VITE_AMAZON_TAG_FR="your-fr-tag-21"
# VITE_AMAZON_TAG_ES="your-es-tag-21"
# VITE_AMAZON_TAG_CA="your-ca-tag-20"
# VITE_AMAZON_TAG_JP="your-jp-tag-22"

# --- Amazon Product Advertising API (optional, server-side) ---
# Leave both empty until Amazon approves your Associates account for
# PA-API access (requires qualifying sales first — see
# https://webservices.amazon.com/paapi5/documentation/). With these
# unset, the app runs exactly as it does today: Gemini-generated
# product ideas linked to an Amazon search. Once both are set (together
# with a real VITE_AMAZON_TAG_* above for the relevant marketplace),
# real product data (ASIN, live price, real rating/reviews, real image)
# automatically replaces the AI estimate for gifts PA-API can match —
# no code changes needed, see paapi.ts.
# AMAZON_PAAPI_ACCESS_KEY=
# AMAZON_PAAPI_SECRET_KEY=
